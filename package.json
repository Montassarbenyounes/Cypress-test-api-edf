{
  "name": "projet-cypress-07-decembre",
  "version": "1.0.0",
  "description": "Cypress API tests for EDF services with TypeScript support",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:headless": "cypress run --headless",
    "test:user": "cypress run --spec 'cypress/e2e/testapi/user/*.spec.ts'",
    "test:carbon": "cypress run --spec 'cypress/e2e/testapi/simulateurEmprunt.spec.ts'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "type-check": "tsc --noEmit --skipLibCheck"
  },
  "keywords": ["cypress", "api-testing", "typescript", "edf"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^15.7.1",
    "typescript": "^5.9.3"
  }
}
